<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Mac App Store distribution. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Outbound network for Matrix API calls. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Inbound loopback listener for the SSO OAuth callback. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Attachment picker (upload) and Save panel (download received files to a
         user-chosen location). Saving via NSSavePanel needs read-write — with
         read-only the panel appears but the write is denied. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
